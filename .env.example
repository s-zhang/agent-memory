# =============================================================================
# Memory Stack — Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Zep ---
ZEP_API_KEY=your_zep_api_key_here

# --- Qdrant ---
QDRANT_API_KEY=your_qdrant_api_key_here

# --- OpenAI (used by Zep for entity extraction + optional embeddings) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Embedding model: "openai" or "local" (nomic-embed via Ollama) ---
EMBEDDING_PROVIDER=openai

# --- BlueBubbles ---
BLUEBUBBLES_URL=http://your-mac-ip:1234
BLUEBUBBLES_PASSWORD=your_bluebubbles_password
BLUEBUBBLES_WEBHOOK_SECRET=your_webhook_secret
# Set to true only when running locally alongside BlueBubbles (not on Railway)
BLUEBUBBLES_PULL_ENABLED=false

# --- Contact Server (resolves phone numbers to names) ---
CONTACT_SERVER_URL=http://desktop1.tail3d8f4.ts.net:9876
CONTACT_SERVER_TOKEN=your_contact_server_token

# --- Email (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_MAILBOX=INBOX

# --- Notion ---
NOTION_API_KEY=your_notion_integration_key
NOTION_WEBHOOK_SECRET=your_notion_webhook_secret

# --- Ingestion ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Internal service URLs (used by MCP server locally) ---
ZEP_URL=http://localhost:8010
QDRANT_URL=http://localhost:6333
